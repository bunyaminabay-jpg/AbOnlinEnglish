<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AbOnlinEnglish – Dil Eğitimi</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root {
  --navy: #0f1e3c;
  --blue: #1a3a6b;
  --accent: #e8a020;
  --accent2: #f0c060;
  --light: #f5f7fa;
  --white: #ffffff;
  --text: #222b3a;
  --muted: #6b7a99;
  --border: #dde3f0;
  --card-shadow: 0 4px 24px rgba(15,30,60,0.10);
  --radius: 14px;
  --green: #27ae60;
  --red: #e74c3c;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:'DM Sans',sans-serif;color:var(--text);background:var(--light);min-height:100vh;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(15,30,60,0.97);backdrop-filter:blur(10px);border-bottom:1px solid rgba(255,255,255,0.07);}
.nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 28px;height:68px;}
.logo-wrap{display:flex;align-items:center;gap:12px;text-decoration:none;}
.logo-svg{width:42px;height:42px;flex-shrink:0;}
.logo-text{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:900;color:var(--white);letter-spacing:-0.5px;line-height:1;}
.logo-text span{color:var(--accent);}
.logo-sub{font-size:.65rem;font-weight:500;color:rgba(255,255,255,0.45);letter-spacing:2px;text-transform:uppercase;margin-top:2px;}
.nav-links{display:flex;gap:2px;list-style:none;}
.nav-links a{color:rgba(255,255,255,0.80);text-decoration:none;font-size:.85rem;font-weight:500;padding:8px 13px;border-radius:8px;transition:all .2s;}
.nav-links a:hover,.nav-links a.active{background:rgba(232,160,32,0.18);color:var(--accent2);}
.hamburger{display:none;background:none;border:none;cursor:pointer;color:white;font-size:1.4rem;}

/* HERO */
.hero{background:linear-gradient(135deg,#0f1e3c 0%,#1a3a6b 55%,#0d2a5a 100%);min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:120px 24px 80px;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 70% 60% at 50% 30%,rgba(232,160,32,0.12) 0%,transparent 70%);}
.hero-badge{display:inline-block;background:rgba(232,160,32,0.2);border:1px solid rgba(232,160,32,0.4);color:var(--accent2);font-size:.8rem;font-weight:600;letter-spacing:2px;text-transform:uppercase;padding:6px 18px;border-radius:50px;margin-bottom:24px;}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(2.4rem,6vw,4.2rem);font-weight:900;color:var(--white);line-height:1.1;margin-bottom:22px;}
.hero h1 em{color:var(--accent);font-style:normal;}
.hero p{font-size:1.15rem;color:rgba(255,255,255,0.72);max-width:560px;margin:0 auto 36px;line-height:1.7;}
.hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;}
.btn-primary{background:var(--accent);color:var(--navy);font-weight:700;padding:14px 32px;border-radius:10px;text-decoration:none;transition:all .2s;border:none;cursor:pointer;font-size:1rem;}
.btn-primary:hover{background:var(--accent2);transform:translateY(-2px);}
.btn-secondary{background:rgba(255,255,255,0.1);color:white;font-weight:600;padding:14px 32px;border-radius:10px;text-decoration:none;transition:all .2s;border:1px solid rgba(255,255,255,0.2);cursor:pointer;font-size:1rem;}
.btn-secondary:hover{background:rgba(255,255,255,0.18);}
.hero-stats{display:flex;gap:40px;justify-content:center;margin-top:56px;flex-wrap:wrap;}
.stat{text-align:center;}
.stat-num{font-family:'Playfair Display',serif;font-size:2.2rem;font-weight:900;color:var(--accent);}
.stat-label{font-size:.8rem;color:rgba(255,255,255,0.5);letter-spacing:1px;text-transform:uppercase;margin-top:4px;}

/* SECTIONS */
section{padding:80px 24px;}
.section-inner{max-width:1200px;margin:0 auto;}
.section-tag{font-size:.75rem;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--accent);margin-bottom:10px;}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(1.8rem,4vw,2.8rem);font-weight:900;color:var(--navy);margin-bottom:16px;line-height:1.2;}
.section-sub{font-size:1.05rem;color:var(--muted);max-width:560px;line-height:1.7;margin-bottom:48px;}

/* ABOUT */
#about{background:var(--white);}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center;}
.about-features{display:grid;gap:20px;margin-top:12px;}
.feature-card{display:flex;gap:16px;align-items:flex-start;background:var(--light);padding:20px;border-radius:var(--radius);border:1px solid var(--border);}
.feature-icon{width:44px;height:44px;background:linear-gradient(135deg,var(--navy),var(--blue));border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.1rem;flex-shrink:0;}
.feature-card h4{font-weight:700;margin-bottom:4px;color:var(--navy);}
.feature-card p{font-size:.9rem;color:var(--muted);line-height:1.5;}
.about-visual{background:linear-gradient(135deg,var(--navy),var(--blue));border-radius:24px;padding:40px;color:white;text-align:center;}
.about-visual .big-icon{font-size:5rem;margin-bottom:20px;opacity:.8;}
.about-visual h3{font-family:'Playfair Display',serif;font-size:1.6rem;margin-bottom:12px;}
.about-visual p{opacity:.75;line-height:1.7;}

/* LEVEL TABS */
.level-tabs{display:flex;gap:8px;margin-bottom:32px;flex-wrap:wrap;}
.level-tab{padding:10px 24px;border-radius:50px;border:2px solid var(--border);background:white;color:var(--muted);font-weight:600;cursor:pointer;transition:all .2s;font-size:.9rem;}
.level-tab.active,.level-tab:hover{background:var(--navy);border-color:var(--navy);color:white;}

/* DOCUMENT CARDS */
#documents{background:var(--light);}
.doc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px;}
.doc-card{background:white;border-radius:var(--radius);padding:22px;border:1px solid var(--border);box-shadow:var(--card-shadow);transition:all .25s;cursor:pointer;text-decoration:none;display:block;}
.doc-card:hover{transform:translateY(-4px);box-shadow:0 12px 36px rgba(15,30,60,0.14);border-color:var(--accent);}
.doc-card-top{display:flex;align-items:center;gap:14px;margin-bottom:14px;}
.pdf-icon{width:46px;height:46px;background:linear-gradient(135deg,var(--navy),var(--blue));border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1rem;flex-shrink:0;}
.doc-level-badge{font-size:.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:rgba(15,30,60,0.08);color:var(--navy);padding:3px 10px;border-radius:4px;}
.doc-card h4{font-weight:700;color:var(--navy);font-size:.95rem;margin-bottom:6px;}
.doc-card p{font-size:.84rem;color:var(--muted);line-height:1.5;}
.doc-action{display:inline-flex;align-items:center;gap:6px;margin-top:14px;padding:8px 16px;background:var(--navy);color:white;border-radius:8px;font-size:.82rem;font-weight:600;text-decoration:none;transition:all .2s;}
.doc-action:hover{background:var(--accent);color:var(--navy);}
.doc-action i{font-size:.75rem;}

/* SKILLS */
#skills{background:white;}
.skills-tabs{display:flex;gap:0;border-bottom:2px solid var(--border);margin-bottom:36px;overflow-x:auto;}
.skill-tab{padding:14px 28px;border:none;background:none;font-weight:600;color:var(--muted);cursor:pointer;position:relative;transition:color .2s;white-space:nowrap;font-family:'DM Sans',sans-serif;font-size:.95rem;}
.skill-tab.active{color:var(--navy);}
.skill-tab.active::after{content:'';position:absolute;bottom:-2px;left:0;right:0;height:2px;background:var(--accent);}
.skill-content{display:none;}
.skill-content.active{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;}
.skill-info h3{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:900;color:var(--navy);margin-bottom:14px;}
.skill-info p{color:var(--muted);line-height:1.7;margin-bottom:20px;font-size:.97rem;}
.skill-tips{background:var(--light);border-radius:var(--radius);padding:22px;border-left:4px solid var(--accent);}
.skill-tips h5{font-weight:700;color:var(--navy);margin-bottom:12px;}
.skill-tips ul{list-style:none;display:grid;gap:8px;}
.skill-tips ul li{display:flex;gap:10px;font-size:.9rem;color:var(--muted);}
.skill-tips ul li::before{content:'✦';color:var(--accent);flex-shrink:0;}
.skill-materials{display:grid;gap:12px;}
.material-item{background:var(--light);border-radius:10px;padding:16px 18px;display:flex;align-items:center;gap:14px;border:1px solid var(--border);text-decoration:none;transition:all .2s;cursor:pointer;}
.material-item:hover{border-color:var(--accent);background:white;}
.mat-icon{width:38px;height:38px;background:linear-gradient(135deg,var(--navy),var(--blue));border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:.9rem;flex-shrink:0;}
.mat-info h5{font-weight:600;font-size:.9rem;color:var(--navy);}
.mat-info p{font-size:.8rem;color:var(--muted);}

/* GRAMMAR */
#grammar{background:var(--light);}
.grammar-layout{display:grid;grid-template-columns:240px 1fr;gap:32px;min-height:500px;}
.grammar-sidebar{background:white;border-radius:var(--radius);border:1px solid var(--border);padding:20px;height:fit-content;position:sticky;top:88px;}
.grammar-sidebar h4{font-weight:700;font-size:.8rem;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);margin-bottom:16px;}
.grammar-level-btn{width:100%;text-align:left;padding:12px 16px;border-radius:8px;border:none;background:none;cursor:pointer;font-family:'DM Sans',sans-serif;font-weight:600;color:var(--navy);font-size:.92rem;transition:all .2s;display:flex;align-items:center;justify-content:space-between;}
.grammar-level-btn:hover{background:var(--light);}
.grammar-level-btn.active{background:var(--navy);color:white;}
.grammar-level-btn .badge{font-size:.7rem;background:rgba(232,160,32,0.2);color:var(--accent);padding:2px 8px;border-radius:4px;font-weight:700;}
.grammar-level-btn.active .badge{background:rgba(255,255,255,0.2);color:white;}
.grammar-main{background:white;border-radius:var(--radius);border:1px solid var(--border);padding:32px;}
.grammar-topic-list{display:grid;gap:14px;}
.grammar-topic-item{padding:18px 22px;border-radius:10px;border:1px solid var(--border);cursor:pointer;transition:all .22s;display:flex;align-items:center;justify-content:space-between;}
.grammar-topic-item:hover{border-color:var(--accent);background:rgba(232,160,32,0.04);}
.grammar-topic-item h5{font-weight:700;color:var(--navy);margin-bottom:4px;}
.grammar-topic-item p{font-size:.83rem;color:var(--muted);}
.grammar-topic-item .arrow{color:var(--accent);font-size:.9rem;}
.grammar-detail-back{display:inline-flex;align-items:center;gap:8px;color:var(--blue);font-weight:600;cursor:pointer;margin-bottom:24px;font-size:.9rem;border:none;background:none;font-family:'DM Sans',sans-serif;}
.grammar-detail h2{font-family:'Playfair Display',serif;font-size:2rem;color:var(--navy);margin-bottom:8px;}
.grammar-detail .level-tag{display:inline-block;background:var(--navy);color:white;font-size:.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:4px 12px;border-radius:4px;margin-bottom:20px;}
.grammar-section{margin-bottom:28px;}
.grammar-section h4{font-weight:700;color:var(--navy);margin-bottom:12px;display:flex;align-items:center;gap:8px;}
.grammar-section h4 i{color:var(--accent);}
.grammar-section p{color:var(--muted);line-height:1.75;font-size:.95rem;}
.example-box{background:var(--light);border-left:4px solid var(--accent);border-radius:0 10px 10px 0;padding:16px 20px;margin:10px 0;}
.example-box .eng{font-weight:700;color:var(--navy);}
.example-box .tr{font-size:.87rem;color:var(--muted);}

/* GRAMMAR TABLE */
.grammar-table{width:100%;border-collapse:collapse;margin:16px 0;font-size:.88rem;}
.grammar-table th{background:var(--navy);color:white;padding:10px 14px;text-align:left;font-weight:700;}
.grammar-table td{padding:10px 14px;border-bottom:1px solid var(--border);vertical-align:top;}
.grammar-table tr:nth-child(even) td{background:#f8f9fc;}
.grammar-table tr:hover td{background:rgba(232,160,32,0.06);}
.grammar-table .pos{color:var(--green);font-weight:600;}
.grammar-table .neg{color:var(--red);font-weight:600;}
.grammar-table .ques{color:var(--blue);font-weight:600;}

/* EXERCISES */
.exercise-list{display:grid;gap:14px;margin-top:12px;}
.exercise-item{background:var(--light);border-radius:10px;padding:18px;border:1px solid var(--border);}
.exercise-item .ex-type{font-size:.72rem;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent);margin-bottom:6px;}
.exercise-item p{font-weight:600;color:var(--navy);margin-bottom:10px;line-height:1.5;}
.exercise-item input[type=text]{border:1px solid var(--border);border-radius:6px;padding:9px 13px;width:100%;max-width:360px;font-family:'DM Sans',sans-serif;font-size:.9rem;outline:none;transition:border .2s;background:white;}
.exercise-item input[type=text]:focus{border-color:var(--accent);}
.exercise-item .options{display:grid;gap:8px;margin-top:4px;}
.exercise-item .opt-btn{text-align:left;padding:9px 16px;border:1px solid var(--border);border-radius:7px;background:white;cursor:pointer;font-family:'DM Sans',sans-serif;font-size:.9rem;transition:all .2s;color:var(--navy);}
.exercise-item .opt-btn:hover{border-color:var(--accent);background:rgba(232,160,32,0.05);}
.exercise-item .opt-btn.correct-ans{background:#eafaf1;border-color:var(--green);color:var(--green);}
.exercise-item .opt-btn.wrong-ans{background:#fdf2f2;border-color:var(--red);color:var(--red);}
.check-btn{margin-top:10px;padding:9px 22px;background:var(--navy);color:white;border:none;border-radius:7px;cursor:pointer;font-weight:600;font-size:.85rem;font-family:'DM Sans',sans-serif;transition:all .2s;}
.check-btn:hover{background:var(--accent);color:var(--navy);}
.answer-feedback{font-size:.85rem;margin-top:8px;font-weight:600;padding:6px 12px;border-radius:6px;display:none;}
.answer-feedback.correct{color:var(--green);background:#eafaf1;display:block;}
.answer-feedback.wrong{color:var(--red);background:#fdf2f2;display:block;}
.t-f-btns{display:flex;gap:10px;margin-top:8px;}
.tf-btn{padding:8px 22px;border:1px solid var(--border);border-radius:7px;background:white;cursor:pointer;font-weight:700;font-size:.9rem;font-family:'DM Sans',sans-serif;transition:all .2s;}
.tf-btn:hover{border-color:var(--accent);}

/* ONLINE LESSON */
#online-lesson{background:linear-gradient(135deg,#0f1e3c 0%,#1a3a6b 100%);}
#online-lesson .section-title{color:white;}
#online-lesson .section-tag{color:var(--accent2);}
#online-lesson .section-sub{color:rgba(255,255,255,0.65);}
.lesson-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:22px;margin-bottom:48px;}
.lesson-card{background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.13);border-radius:var(--radius);padding:28px;color:white;transition:all .25s;position:relative;overflow:hidden;}
.lesson-card::before{content:'';position:absolute;top:-30px;right:-30px;width:100px;height:100px;background:rgba(232,160,32,0.1);border-radius:50%;}
.lesson-card:hover{background:rgba(255,255,255,0.12);transform:translateY(-4px);}
.lesson-card-icon{font-size:2.2rem;margin-bottom:16px;}
.lesson-card h3{font-family:'Playfair Display',serif;font-size:1.2rem;font-weight:900;margin-bottom:10px;color:var(--accent2);}
.lesson-card p{font-size:.9rem;color:rgba(255,255,255,0.7);line-height:1.65;}
.lesson-card ul{list-style:none;margin-top:12px;display:grid;gap:6px;}
.lesson-card ul li{font-size:.88rem;color:rgba(255,255,255,0.7);display:flex;gap:8px;}
.lesson-card ul li::before{content:'✓';color:var(--accent);font-weight:700;flex-shrink:0;}
.lesson-pricing{background:rgba(255,255,255,0.07);border:1px solid rgba(232,160,32,0.3);border-radius:var(--radius);padding:32px;color:white;text-align:center;max-width:900px;margin:0 auto;}
.lesson-pricing h3{font-family:'Playfair Display',serif;font-size:1.6rem;margin-bottom:24px;color:var(--accent2);}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:28px;}
.price-item{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);border-radius:10px;padding:20px;}
.price-item .duration{font-size:.8rem;color:rgba(255,255,255,0.5);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;}
.price-item .price{font-family:'Playfair Display',serif;font-size:2rem;font-weight:900;color:var(--accent);}
.price-item .price-sub{font-size:.8rem;color:rgba(255,255,255,0.5);margin-top:4px;}
.lesson-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:16px;}
.btn-whatsapp{background:#25D366;color:white;font-weight:700;padding:14px 28px;border-radius:10px;text-decoration:none;transition:all .2s;display:inline-flex;align-items:center;gap:8px;font-size:.95rem;}
.btn-whatsapp:hover{background:#1da855;transform:translateY(-2px);}
.btn-email-lesson{background:var(--accent);color:var(--navy);font-weight:700;padding:14px 28px;border-radius:10px;text-decoration:none;transition:all .2s;display:inline-flex;align-items:center;gap:8px;font-size:.95rem;}
.btn-email-lesson:hover{background:var(--accent2);transform:translateY(-2px);}
.teacher-box{display:flex;gap:24px;align-items:center;background:rgba(255,255,255,0.06);border-radius:var(--radius);padding:24px;margin-bottom:40px;border:1px solid rgba(255,255,255,0.1);max-width:700px;}
.teacher-avatar{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-size:2.2rem;flex-shrink:0;border:3px solid rgba(232,160,32,0.5);}
.teacher-info h4{font-family:'Playfair Display',serif;font-size:1.2rem;color:var(--accent2);margin-bottom:6px;}
.teacher-info p{font-size:.9rem;color:rgba(255,255,255,0.65);line-height:1.6;}

/* CONTACT */
#contact{background:var(--navy);color:white;}
#contact .section-title{color:white;}
#contact .section-tag{color:var(--accent2);}
#contact .section-sub{color:rgba(255,255,255,0.6);}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start;}
.contact-info{display:grid;gap:20px;margin-top:8px;}
.contact-item{display:flex;gap:16px;align-items:flex-start;}
.contact-item-icon{width:44px;height:44px;background:rgba(232,160,32,0.15);border:1px solid rgba(232,160,32,0.3);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent);font-size:1.1rem;flex-shrink:0;}
.contact-item h5{font-weight:700;color:white;margin-bottom:4px;}
.contact-item p,.contact-item a{color:rgba(255,255,255,0.6);font-size:.9rem;text-decoration:none;}
.contact-item a:hover{color:var(--accent2);}
.contact-form{display:grid;gap:16px;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-group label{font-size:.84rem;font-weight:600;color:rgba(255,255,255,0.75);}
.form-group input,.form-group textarea,.form-group select{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);border-radius:10px;padding:12px 16px;color:white;font-family:'DM Sans',sans-serif;font-size:.92rem;outline:none;transition:border .2s;}
.form-group input::placeholder,.form-group textarea::placeholder{color:rgba(255,255,255,0.35);}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{border-color:var(--accent);}
.form-group textarea{resize:vertical;min-height:110px;}
.form-group select option{background:var(--navy);color:white;}
.form-submit{padding:14px;background:var(--accent);color:var(--navy);font-weight:700;border:none;border-radius:10px;cursor:pointer;font-size:1rem;font-family:'DM Sans',sans-serif;transition:all .2s;margin-top:4px;}
.form-submit:hover{background:var(--accent2);}

/* FOOTER */
footer{background:#07111f;color:rgba(255,255,255,0.45);text-align:center;padding:32px 24px;font-size:.85rem;}
footer strong{color:var(--accent);}
.footer-socials{display:flex;justify-content:center;gap:16px;margin:16px 0;}
