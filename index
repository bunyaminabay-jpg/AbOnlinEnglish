let activeDocLevel = 'ALL';
function filterDocs(level, event){
  activeDocLevel = level;
  document.querySelectorAll('.level-tab').forEach(t=>t.classList.remove('active'));
  if(event) event.target.classList.add('active');
  renderDocs();
}
function renderDocs(){
  const grid = document.getElementById('docGrid');
  const filtered = activeDocLevel==='ALL' ? docs : docs.filter(d=>d.level===activeDocLevel);
  grid.innerHTML = filtered.map(d=>`
    <div class="doc-card" onclick="goToGrammarTopic('${d.grammarKey}',${d.topicIdx})">
      <div class="doc-card-top">
        <div class="pdf-icon"><i class="fas fa-book-open"></i></div>
        <span class="doc-level-badge">${d.level}</span>
      </div>
      <h4>${d.title}</h4>
      <p>${d.desc}</p>
      <span class="doc-action"><i class="fas fa-arrow-right"></i> Konu Anlatımına Git</span>
    </div>
  `).join('');
}

function goToGrammarTopic(level, topicIdx){
  activeGrammarLevel = level;
  activeGrammarTopic = topicIdx;
  renderGrammarSidebar();
