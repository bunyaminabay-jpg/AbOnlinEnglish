/* ===================== GRAMMAR RENDER ===================== */
let activeGrammarLevel = 'A1';
let activeGrammarTopic = null;

function renderGrammarSidebar(){
  const sb = document.getElementById('grammarSidebar');
  sb.innerHTML = `<h4>Seviyeler</h4>` + Object.keys(grammar).map(lvl=>`
    <button class="grammar-level-btn ${lvl===activeGrammarLevel?'active':''}" onclick="setGrammarLevel('${lvl}')">
      ${lvl} <span class="badge">${grammar[lvl].topics.length} konu</span>
    </button>
  `).join('');
}

function setGrammarLevel(lvl){
  activeGrammarLevel = lvl;
  activeGrammarTopic = null;
  renderGrammarSidebar();
  renderGrammarMain();
}

function renderGrammarMain(){
  const main = document.getElementById('grammarMain');
  if(activeGrammarTopic !== null){
    const t = grammar[activeGrammarLevel].topics[activeGrammarTopic];
    // Build table HTML
    let tableHTML = '';
    if(t.table && t.table.length){
      tableHTML = `<table class="grammar-table"><thead><tr>${t.table[0].map(h=>`<th>${h}</th>`).join('')}</tr></thead><tbody>${t.table.slice(1).map(row=>`<tr>${row.map(cell=>`<td>${cell}</td>`).join('')}</tr>`).join('')}</tbody></table>`;
    }
    // Notes
    let notesHTML = '';
    if(t.notes && t.notes.length){
      notesHTML = `<div class="skill-tips" style="margin-top:14px;"><h5>📌 Notlar</h5><ul>${t.notes.map(n=>`<li>${n}</li>`).join('')}</ul></div>`;
    }
    // Exercises
    const exHTML = t.exercises.map((ex,i)=>{
      const id = `ex_${activeGrammarLevel}_${activeGrammarTopic}_${i}`;
      if(ex.type==='fill'){
        return `<div class="exercise-item"><div class="ex-type">Doldurma</div><p>${i+1}. ${ex.q}</p><input type="text" id="${id}" placeholder="Cevabınızı yazın..."><button class="check-btn" onclick="checkAnswer('${id}','${ex.a.replace(/'/g,"\\'").replace(/"/g,'&quot;')}',this)">Kontrol Et</button><div class="answer-feedback" id="fb_${id}"></div></div>`;
      } else if(ex.type==='mc'){
        return `<div class="exercise-item"><div class="ex-type">Çoktan Seçmeli</div><p>${i+1}. ${ex.q}</p><div class="options">${ex.opts.map(o=>`<button class="opt-btn" onclick="checkMC(this,'${o.replace(/'/g,"\\'").replace(/"/g,'&quot;')}','${ex.a.replace(/'/g,"\\'").replace(/"/g,'&quot;')}','fb_${id}')">${o}</button>`).join('')}</div><div class="answer-feedback" id="fb_${id}"></div></div>`;
      } else if(ex.type==='tf'){
        return `<div class="exercise-item"><div class="ex-type">Doğru / Yanlış</div><p>${i+1}. ${ex.q}</p><div class="t-f-btns"><button class="tf-btn" onclick="checkTF(this,true,${ex.a},'fb_${id}')">✔ Doğru</button><button class="tf-btn" onclick="checkTF(this,false,${ex.a},'fb_${id}')">✘ Yanlış</button></div><div class="answer-feedback" id="fb_${id}">${ex.explain?'<span style="display:none" data-explain="'+ex.explain+'"></span>':''}</div></div>`;
      } else if(ex.type==='transform'){
        return `<div class="exercise-item"><div class="ex-type">Dönüştürme</div><p>${i+1}. ${ex.q}</p><input type="text" id="${id}" placeholder="Cevabınızı yazın..."><button class="check-btn" onclick="checkAnswer('${id}','${ex.a.replace(/'/g,"\\'").replace(/"/g,'&quot;')}',this)">Kontrol Et</button><div class="answer-feedback" id="fb_${id}"></div></div>`;
      }
      return '';
    }).join('');

    main.innerHTML = `
      <div class="grammar-main">
        <button class="grammar-detail-back" onclick="activeGrammarTopic=null;renderGrammarMain()"><i class="fas fa-arrow-left"></i> Konulara Dön</button>
        <span class="level-tag">${t.cefr} –CEFR</span>
        <h2 class="grammar-detail">${t.title}</h2>
        <p style="color:var(--muted);margin-bottom:20px;font-size:.97rem;">${t.sub}</p>

        <div class="grammar-section">
          <h4><i class="fas fa-book"></i> Açıklama</h4>
          <p>${t.explanation}</p>
        </div>
        <div class="grammar-section">
          <h4><i class="fas fa-table"></i> Yapı Tablosu</h4>
          ${tableHTML}
          ${notesHTML}
        </div>
        <div class="grammar-section">
          <h4><i class="fas fa-lightbulb"></i> Örnekler</h4>
          ${t.examples.map(e=>`<div class="example-box"><div class="eng">${e.eng}</div><div class="tr">${e.tr}</div></div>`).join('')}
        </div>
        <div class="grammar-section">
          <h4><i class="fas fa-pencil-alt"></i> Alıştırmalar (${t.exercises.length} soru)</h4>
          <div class="exercise-list">${exHTML}</div>
        </div>
      </div>`;
  } else {
    const topics = grammar[activeGrammarLevel].topics;
    main.innerHTML = `
      <div class="grammar-main">
        <h3 style="font-family:'Playfair Display',serif;font-size:1.5rem;color:var(--navy);margin-bottom:8px;">${grammar[activeGrammarLevel].label} Konuları</h3>
        <p style="color:var(--muted);margin-bottom:24px;">${topics.length} konu — CEFR müfredatına göre hazırlanmıştır.</p>
        <div class="grammar-topic-list">
          ${topics.map((t,i)=>`
            <div class="grammar-topic-item" onclick="activeGrammarTopic=${i};renderGrammarMain();renderGrammarSidebar();">
              <div>
                <h5>${t.title}</h5>
                <p>${t.sub}</p>
              </div>
              <i class="fas fa-chevron-right arrow"></i>
            </div>
          `).join('')}
        </div>
      </div>`;
  }
}

renderGrammarSidebar();
renderGrammarMain();

/* ===================== EXERCISE CHECKERS ===================== */
function checkAnswer(inputId, correct, btn){
  const input = document.getElementById(inputId);
  const fb = document.getElementById('fb_'+inputId);
  const userAnswer = input.value.trim().toLowerCase().replace(/\s+/g,' ');
  const correctAnswers = correct.toLowerCase().split('/').map(s=>s.trim());
  const isCorrect = correctAnswers.some(ca => userAnswer === ca);
  if(isCorrect){
    fb.textContent = '✓ Doğru!';
    fb.className = 'answer-feedback correct';
    input.style.borderColor='#27ae60';
  } else {
    fb.innerHTML = `✗ Yanlış. Doğru cevap: <strong>${correct}</strong>`;
    fb.className = 'answer-feedback wrong';
    input.style.borderColor='#e74c3c';
  }
}

function checkMC(btn, selected, correct, fbId){
  const allBtns = btn.closest('.options').querySelectorAll('.opt-btn');
  allBtns.forEach(b=>{
    b.disabled=true;
    b.classList.remove('correct-ans','wrong-ans');
    if(b.textContent.trim()===correct) b.classList.add('correct-ans');
    else if(b.textContent.trim()===selected && selected!==correct) b.classList.add('wrong-ans');
  });
  const fb = document.getElementById(fbId);
  if(selected===correct){
    fb.textContent='✓ Doğru!';
    fb.className='answer-feedback correct';
  } else {
    fb.innerHTML=`✗ Yanlış. Doğru cevap: <strong>${correct}</strong>`;
    fb.className='answer-feedback wrong';
  }
}

function checkTF(btn, userVal, correctVal, fbId){
  const btns = btn.closest('.t-f-btns').querySelectorAll('.tf-btn');
  btns.forEach(b=>b.disabled=true);
  const fb = document.getElementById(fbId);
  const explainEl = fb.querySelector('[data-explain]');
  const explain = explainEl ? explainEl.dataset.explain : '';
  if(userVal===correctVal){
    btn.style.background='#eafaf1';btn.style.borderColor='#27ae60';btn.style.color='#27ae60';
    fb.textContent='✓ Doğru!';
    fb.className='answer-feedback correct';
  } else {
    btn.style.background='#fdf2f2';btn.style.borderColor='#e74c3c';btn.style.color='#e74c3c';
    fb.innerHTML=`✗ Yanlış.${explain?' '+explain:''}`;
    fb.className='answer-feedback wrong';
  }
}

/* ===================== UTILS ===================== */
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = '✅ '+msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'),2800);
}
function submitForm(e){
  e.preventDefault();
  showToast('Mesajınız gönderildi! En kısa sürede dönüş yapacağız.');
  e.target.reset();
}
function toggleMenu(){
  document.getElementById('navLinks').classList.toggle('open');
}
function closeMenu(){
  document.getElementById('navLinks').classList.remove('open');
}

/* NAV HIGHLIGHT */
const sections = document.querySelectorAll('section');
const navLinksAll = document.querySelectorAll('.nav-links a');
window.addEventListener('scroll',()=>{
  let cur='';
  sections.forEach(s=>{if(window.scrollY>=s.offsetTop-100)cur=s.id;});
  navLinksAll.forEach(a=>{a.classList.toggle('active',a.getAttribute('href')==='#'+cur);});
});
</script>
